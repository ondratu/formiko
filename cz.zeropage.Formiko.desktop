[Desktop Entry]
Type=Application
Name=Formiko
Comment=reStructuredText and MarkDown editor and live html previewer
Exec=formiko %f
Icon=formiko
StartupWMClass=cz.zeropage.Formiko
Terminal=false
MimeType=text/plain;text/html;text/x-markdown;text/x-rst;application/json;text/json;
Categories=Office;WordProcessor;GNOME;GTK;
Keywords=Text;Editor;MarkDown;reStructuredText;Documentation;Markup;
Actions=NewWindow;NewTab;

[Desktop Action NewWindow]
Name=New Window
Exec=formiko --new-window %F

[Desktop Action NewTab]
Name=New Tab
Exec=formiko --new-tab %F
